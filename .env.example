# ========================================
# КОНФИГУРАЦИЯ ДЛЯ АНАЛИЗА ДЕФЕКТОВ
# ========================================

# === API ТОКЕНЫ ===

# Telegram Bot Token
# Получить у @BotFather в Telegram
# Необходим для работы Telegram бота (main.py)
BOT_TOKEN=your_telegram_bot_token_here

# OpenAI API Key
# Получить на https://platform.openai.com/api-keys
# Необходим для:
#   - Распознавания текста (OCR)
#   - Семантического анализа страниц
#   - Vision LLM для очистки текста
#   - Анализа дефектов через GPT
OPENAI_API_KEY=sk-your_openai_key_here

# ========================================
# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ
# ========================================
# Все остальные настройки находятся в config.py:
# - SEMANTIC_SCORE_THRESHOLD: порог отбора страниц (0.5)
# - SEMANTIC_TOP_PAGES_LIMIT: макс. страниц для анализа (10)
# - VLM_MODEL: модель для Vision LLM ("gpt-4.1-mini")
# - ANALYSIS_MODEL: модель для анализа дефектов ("gpt-4.1-2025-04-14")